    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "sudo": true,
        },
        {
            "name": "Python: Module - main",
            "type": "debugpy",
            "request": "launch",
            "module": "vpnc.main",
            "console": "integratedTerminal",
            "justMyCode": true,
            "sudo": true,
            "cwd": "${workspaceFolder}/vpnc/"
        },
        {
            "name": "Python: Module - vpncmangle",
            "type": "debugpy",
            "request": "launch",
            "module": "vpncmangle.main",
            "console": "integratedTerminal",
            "justMyCode": true,
            "sudo": true,
            "cwd": "${workspaceFolder}/vpnc/"
        }
    ]
}
