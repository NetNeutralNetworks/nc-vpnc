[Unit]
Description=ncubed VPNC strongSwan IPsec init
# Keep restarting, e.g. while FRR fails to start.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/ncubed
ExecStart=/opt/ncubed/vpnc/bin/vpnc
# vtysh's history, not in /root (which the AppArmor profile denies).
Environment=VTYSH_HISTFILE=/dev/null
Restart=on-failure
# 15, 21, 30, 42, then every 60 s.
RestartSec=15
RestartSteps=4
RestartMaxDelaySec=60

# Also for charon, FRR, vpncmangle and ssh, which vpnc starts. No file system
# options: vpnc would get its own mount namespace, and the network namespaces it
# mounts there wouldn't be seen outside it.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service @mount
# No core dumps: they'd hold keys.
LimitCORE=0
# Network and mount namespaces only (ip netns): no user namespaces, a common way
# into kernel bugs.
RestrictNamespaces=net mnt
MemoryDenyWriteExecute=yes
UMask=0077
# Its own UTS namespace and no clock changes: neither needs a mount namespace.
ProtectHostname=yes
ProtectClock=yes
# Out of memory, other processes go first.
OOMScoreAdjust=-500
# Not started without its profile (/etc/apparmor.d/ncubed-vpnc).
AppArmorProfile=ncubed-vpnc
# The daemons keep NET_ADMIN, NET_RAW, NET_BIND_SERVICE and SYS_ADMIN; vpnc also
# starts them as their users, writes their files and signals them.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_ADMIN \
	CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_CHOWN CAP_FOWNER CAP_FSETID \
	CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_KILL CAP_IPC_LOCK CAP_SYS_RESOURCE

[Install]
WantedBy=multi-user.target
