{#- CORE: BGP and BFD from the uplinks, IPv6 forwarded from them; no IPv4 except forwarding in ENDPOINT mode. #}
    chain input {
        type filter hook input priority filter; policy drop;
        meta l4proto ipv6-icmp jump icmpv6-in-out
        meta nfproto ipv6 ct state established,related accept
{%- if mode.name == "HUB" %}
  {%- for interface in interfaces %}
    {%- if bgp_neighbors %}
        iifname "{{ interface }}" ip6 saddr { {{ bgp_neighbors | join(", ") }} } tcp dport 179 accept
    {%- endif %}
        {#- BFD: single hop, echo, multihop and micro. #}
        meta nfproto ipv6 iifname "{{ interface }}" udp dport { 3784, 3785, 4784, 6784 } accept
  {%- endfor %}
{%- endif %}
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        meta nfproto ipv6 jump icmpv6-forward
{%- if mode.name == "ENDPOINT" %}
  {%- for interface in interfaces %}
        meta nfproto ipv4 iifname "{{ interface }}" accept
  {%- endfor %}
        meta nfproto ipv4 ct state established,related accept
{%- endif %}
{%- for interface in interfaces %}
        meta nfproto ipv6 iifname "{{ interface }}" accept
{%- endfor %}
        meta nfproto ipv6 ct state established,related accept
    }

    chain output {
        type filter hook output priority filter; policy accept;
        meta l4proto ipv6-icmp jump icmpv6-in-out
        meta nfproto ipv4 drop
    }

{% include 'nft-icmpv6-in-out.conf.j2' %}

{% include 'nft-icmpv6-forward.conf.j2' %}
