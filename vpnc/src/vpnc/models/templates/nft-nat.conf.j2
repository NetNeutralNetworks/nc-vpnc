{#- NPTv6 towards the connections, and masquerading out of them (IPv4 only in ENDPOINT mode). #}
    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
{%- for interface in core_interfaces %}
  {%- for network in nptv6_networks %}
        iifname "{{ interface }}" ip6 daddr {{ network.nptv6_prefix }} dnat ip6 prefix to {{ network.to }}
  {%- endfor %}
{%- endfor %}
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
{%- for interface in downlink_interfaces %}
  {%- if mode.name == "ENDPOINT" %}
        meta nfproto ipv4 oifname "{{ interface }}" masquerade
  {%- endif %}
        meta nfproto ipv6 oifname "{{ interface }}" masquerade
{%- endfor %}
    }
