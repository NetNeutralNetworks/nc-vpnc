{#- DOWNLINK: IPv6 from CORE and return traffic; SSH for the tunnels; NPTv6 and NAT66. #}
    chain input {
        type filter hook input priority filter; policy drop;
        meta l4proto ipv6-icmp jump icmpv6-in-out
{%- for interface in downlink_interfaces %}
        iifname "{{ interface }}" ct state established,related accept
{%- endfor %}
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
{%- for interface in core_interfaces %}
        meta nfproto ipv6 iifname "{{ interface }}" accept
{%- endfor %}
        meta nfproto ipv6 ct state established,related accept
    }

    chain output {
        type filter hook output priority filter; policy drop;
        meta l4proto ipv6-icmp jump icmpv6-in-out
        meta nfproto ipv6 ct state established,related accept
{%- for interface in downlink_interfaces %}
        {#- SSH tunnels. #}
        oifname "{{ interface }}" tcp dport 22 accept
{%- endfor %}
    }

{% include 'nft-icmpv6-in-out.conf.j2' %}

{% include 'nft-nat.conf.j2' %}
