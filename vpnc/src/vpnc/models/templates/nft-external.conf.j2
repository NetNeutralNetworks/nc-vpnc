{#- EXTERNAL: only IKE and ESP from IPsec peers, WireGuard from its peers. #}
{%- macro set(name, type, elements) %}
    set {{ name }} {
        type {{ type }}
{%- if elements %}
        elements = { {{ elements | join(", ") }} }
{%- endif %}
    }
{%- endmacro %}
{{ set("wireguard_ports", "inet_service", wireguard_ports) }}
{#- The remote_addrs of enabled connections; WireGuard's with the local port. #}
{{ set("ipsec_peers_ipv4", "ipv4_addr", ipsec_peers_ipv4) }}
{{ set("ipsec_peers_ipv6", "ipv6_addr", ipsec_peers_ipv6) }}
{{ set("wireguard_peers_ipv4", "ipv4_addr . inet_service", wireguard_peers_ipv4) }}
{{ set("wireguard_peers_ipv6", "ipv6_addr . inet_service", wireguard_peers_ipv6) }}

    chain input {
        type filter hook input priority filter; policy drop;
        {#- Routes are configured: anyone on the external network could add one. #}
        icmpv6 type nd-router-advert drop
        meta l4proto ipv6-icmp jump icmpv6-in-out
        {#- Path MTU discovery of the tunnels: only for packets vpnc sent. #}
        icmp type destination-unreachable icmp code frag-needed ct state related accept
        ip saddr @ipsec_peers_ipv4 jump ipsec-peers
        ip6 saddr @ipsec_peers_ipv6 jump ipsec-peers
        ip saddr . udp dport @wireguard_peers_ipv4 accept
        ip6 saddr . udp dport @wireguard_peers_ipv6 accept
    }

    chain ipsec-peers {
        meta l4proto esp accept
        {#- No source port, so peers behind a NAT can connect. #}
        udp dport { 500, 4500 } accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        type filter hook output priority filter; policy drop;
        meta l4proto ipv6-icmp jump icmpv6-in-out
        meta l4proto esp accept
        udp sport 500 udp dport 500 accept
        udp sport 4500 udp dport 4500 accept
        udp sport @wireguard_ports accept
        {#- Return traffic to peers behind a NAT. #}
        meta l4proto udp ct state established,related accept
    }

{% include 'nft-icmpv6-in-out.conf.j2' %}
