{#- ICMPv6 needed for IPv6 connectivity, for traffic to and from this namespace.
    No router solicitations or advertisements: addresses and routes are configured. #}
    chain icmpv6-in-out {
        icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, echo-request, echo-reply, mld-listener-query, mld-listener-report, mld2-listener-report, mld-listener-done, nd-neighbor-solicit, nd-neighbor-advert } counter accept
        meta l4proto ipv6-icmp counter drop
    }
